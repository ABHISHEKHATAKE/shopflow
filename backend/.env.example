NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://shop:shop@localhost:5432/shopflow
REDIS_URL=redis://localhost:6379
JWT_ACCESS_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
CLIENT_URL=http://localhost:5173
ORDER_EXPIRY_MINUTES=15

# Leave Razorpay values empty to run in MOCK payment mode (no account needed).
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Raise these only for load testing (k6), otherwise defaults apply.
# RATE_LIMIT_MAX=300
# AUTH_RATE_LIMIT_MAX=20
